{
  "assistantRules" : [
    {
      "labelPattern" : "(?i)^Claude responded:",
      "roles" : [
        "AXHeading"
      ]
    }
  ],
  "bundleIdentifier" : "com.anthropic.claudefordesktop",
  "conversationRules" : [
    {
      "labelPattern" : "^Chat messages$",
      "roles" : [
        "AXGroup"
      ]
    }
  ],
  "excludedRoles" : [
    "AXTextArea",
    "AXTextField",
    "AXComboBox",
    "AXButton",
    "AXMenu",
    "AXToolbar"
  ],
  "generationRules" : [
    {
      "labelPattern" : "(?i)^(stop response|stop generating|停止生成|停止回答)$",
      "roles" : [
        "AXButton"
      ]
    }
  ],
  "maxDepth" : 40,
  "maxNodes" : 6000,
  "pollInterval" : 1.5,
  "settlingSeconds" : 3,
  "textRoles" : [
    "AXStaticText"
  ],
  "userRules" : [
    {
      "labelPattern" : "(?i)^You said:",
      "roles" : [
        "AXHeading"
      ]
    }
  ]
